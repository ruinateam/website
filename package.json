{
  "name": "ruinateam",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./lib/nuxt-paths-proxy.mjs"
  },
  "scripts": {
    "dev": "nuxt dev --host",
    "clean": "bun scripts/clean-output.ts",
    "build": "bun run clean && nuxt generate",
    "preview": "sirv dist/public -p 4173",
    "preview:build": "bun run build && bun run preview",
    "fetch:data": "bun scripts/fetch-data.ts",
    "scan:roles": "bun scripts/scan-roles.ts",
    "validate:animations": "bun scripts/validate-animations.ts",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run clean && nuxt prepare && vue-tsc --noEmit --skipLibCheck",
    "test": "bun run lint && bun run validate:animations && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "glob": "^13.0.6",
    "skinview3d": "3.4.2",
    "skinview3d-blockbench": "1.0.19"
  },
  "devDependencies": {
    "@nuxt/content": "3.16.1",
    "@nuxt/kit": "4.5.2",
    "@parcel/watcher": "2.6.0",
    "better-sqlite3": "^13.0.3",
    "nuxt": "4.5.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "rolldown": "1.2.11",
    "sirv-cli": "3.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "bun@1.4.0"
}
